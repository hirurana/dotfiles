# skhd — app hotkeys. Cmd+Opt+<n> focuses the app, launching it if it isn't running.
# Reload: skhd --reload   ·   Docs: ~/dotfiles/docs/hotkeys.md

cmd + alt - 1 : open -a "Ghostty"
cmd + alt - 2 : open -a "Google Chrome"
cmd + alt - 3 : open -a "Spotify"
cmd + alt - 4 : open -a "Notion"
cmd + alt - 5 : open -a "Slack"
cmd + alt - 6 : open -a "Cursor"
cmd + alt - 7 : open -a "Linear"
cmd + alt - 8 : open -a "Microsoft Teams"
